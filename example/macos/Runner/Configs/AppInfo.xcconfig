// The part of a Flutter macos/Runner/Configs/AppInfo.xcconfig that
// flutter_build_tools reads: PRODUCT_NAME becomes macos.appName (the bundle is
// example_app.app). A real project has the whole file, written by `flutter create`.

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = example_app

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = com.example.exampleApp
